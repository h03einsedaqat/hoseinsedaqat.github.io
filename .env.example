# Optional Server-Side AI Provider (leave empty to use the built-in Verified Resume Knowledge Base)
# Never expose API keys with NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional GitHub Personal Access Token (increases server-side GitHub API rate limit; public API works without it)
GITHUB_TOKEN=

# Canonical site URL for SEO metadata, sitemap, and OpenGraph
NEXT_PUBLIC_SITE_URL=https://hoseinsedaqat.github.io
